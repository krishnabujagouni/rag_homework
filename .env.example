OPENAI_API_KEY=
PINECONE_API_KEY=

PINECONE_INDEX_NAME=rag-homework
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# EMBEDDING_DIM must match the model: text-embedding-3-small=1536,
# text-embedding-3-large=3072. text-embedding-3-* also accept a smaller
# value to emit shorter vectors. Changing either one recreates the index.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o

BM25_PARAMS_PATH=bm25_params.json
